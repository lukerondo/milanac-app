{
  "cleanUrls": true,
  "buildCommand": "bash ../tools/web/build_vercel.sh",
  "redirects": [
    { "source": "/app", "destination": "/app/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(img|video|audio)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
